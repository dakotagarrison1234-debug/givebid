generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  description     String?
  logoUrl         String?
  stripeAccountId String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  auctions        Auction[]
  items           Item[]
  members         OrgMember[]
  invites         OrgInvite[]
}

model OrgMember {
  id             String       @id @default(cuid())
  clerkUserId    String
  organizationId String
  role           OrgRole      @default(STAFF)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([clerkUserId, organizationId])
}

enum OrgRole {
  OWNER
  ADMIN
  STAFF
}model Auction {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  status         AuctionStatus @default(DRAFT)
  slug           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  items          Item[]

  @@unique([organizationId, slug])
}

enum AuctionStatus {
  DRAFT
  OPEN
  CLOSING
  CLOSED
  SETTLED
}model Item {
  id              String       @id @default(cuid())
  organizationId  String
  auctionId       String?
  uniqueId        String       @unique @default(cuid())
  title           String
  description     String?
  condition       Condition    @default(GOOD)
  category        String?
  retailValue     Float?
  startingBid     Float        @default(0)
  reservePrice    Float?
  currentBid      Float        @default(0)
  donorName       String?
  taxDeductible   Boolean      @default(false)
  storageLocation String?
  notes           String?
  status          ItemStatus   @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  auction         Auction?     @relation(fields: [auctionId], references: [id])
  photos          ItemPhoto[]
  bids            Bid[]
  payments        Payment[]
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ItemStatus {
  DRAFT
  ACTIVE
  SOLD
  UNSOLD
  PENDING_PICKUP
  PICKED_UP
}model ItemPhoto {
  id        String   @id @default(cuid())
  itemId    String
  url       String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  item      Item     @relation(fields: [itemId], references: [id])
}

model Bid {
  id          String    @id @default(cuid())
  itemId      String
  clerkUserId String
  amount      Float
  status      BidStatus @default(ACTIVE)
  placedAt    DateTime  @default(now())
  item        Item      @relation(fields: [itemId], references: [id])
}

enum BidStatus {
  ACTIVE
  OUTBID
  WON
  CANCELLED
}

model Payment {
  id                    String        @id @default(cuid())
  clerkUserId           String
  itemId                String
  amount                Float
  stripePaymentIntentId String?
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  item                  Item          @relation(fields: [itemId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}
model BidderProfile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  phone       String?
  email       String?
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrgApplication {
  id           String            @id @default(cuid())
  clerkUserId  String
  orgName      String
  slug         String
  description  String?
  website      String?
  contactName  String
  contactEmail String
  contactPhone String?
  status       ApplicationStatus @default(PENDING)
  reviewedBy   String?
  reviewNote   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([clerkUserId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model OrgInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole      @default(STAFF)
  token          String       @unique @default(cuid())
  clerkUserId    String?
  accepted       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([email])
  @@index([token])
}

model PaymentBatch {
  id          String   @id @default(cuid())
  clerkUserId String
  itemIds     String   // JSON array of item IDs
  bidIds      String   // JSON array of bid IDs
  createdAt   DateTime @default(now())

  @@index([clerkUserId])
}